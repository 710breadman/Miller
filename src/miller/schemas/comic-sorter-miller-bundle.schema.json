{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comic-sorter.local/schemas/miller-bundle.schema.json",
  "title": "Comic Sorter Miller Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "bundle_id", "created_at", "library_id", "generator", "request", "documents", "stories", "pages", "panels", "entities", "events", "arcs", "themes", "evidence", "candidates", "warnings"],
  "properties": {
    "schema": {"const": "comic-sorter.miller-bundle"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "library_id": {"$ref": "#/$defs/id"},
    "generator": {"type": "object", "additionalProperties": false, "required": ["name", "version", "analysis_profile"], "properties": {"name": {"const": "comic-sorter"}, "version": {"type": "string"}, "analysis_profile": {"type": "string"}}},
    "request": {"type": "object"},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "stories": {"type": "array", "items": {"$ref": "#/$defs/story"}},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "panels": {"type": "array", "items": {"$ref": "#/$defs/panel"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "arcs": {"type": "array", "items": {"$ref": "#/$defs/arc"}},
    "themes": {"type": "array", "items": {"$ref": "#/$defs/theme"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "idList": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "document": {"type": "object", "additionalProperties": true, "required": ["document_id", "issue_id", "checksum"], "properties": {"document_id": {"$ref": "#/$defs/id"}, "issue_id": {"$ref": "#/$defs/id"}, "checksum": {"type": "string"}, "source_path": {"type": ["string", "null"]}, "locator": {"type": ["string", "null"]}}},
    "story": {"type": "object", "additionalProperties": true, "required": ["story_id", "document_id", "title"], "properties": {"story_id": {"$ref": "#/$defs/id"}, "document_id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}}},
    "page": {"type": "object", "additionalProperties": true, "required": ["page_id", "document_id", "archive_path", "page_index", "checksum"], "properties": {"page_id": {"$ref": "#/$defs/id"}, "document_id": {"$ref": "#/$defs/id"}, "archive_path": {"type": "string"}, "page_index": {"type": "integer", "minimum": 0}, "checksum": {"type": "string"}, "thumbnail_path": {"type": ["string", "null"]}}},
    "panel": {"type": "object", "additionalProperties": true, "required": ["panel_id", "page_id", "reading_order", "bounds"], "properties": {"panel_id": {"$ref": "#/$defs/id"}, "page_id": {"$ref": "#/$defs/id"}, "reading_order": {"type": "integer", "minimum": 0}, "bounds": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}}}},
    "entity": {"type": "object", "additionalProperties": true, "required": ["entity_id", "entity_type", "name"], "properties": {"entity_id": {"$ref": "#/$defs/id"}, "entity_type": {"type": "string"}, "name": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}}},
    "event": {"type": "object", "additionalProperties": true, "required": ["event_id", "summary", "confidence", "evidence_ids"], "properties": {"event_id": {"$ref": "#/$defs/id"}, "summary": {"type": "string"}, "confidence": {"$ref": "#/$defs/score"}, "evidence_ids": {"$ref": "#/$defs/idList"}}},
    "arc": {"type": "object", "additionalProperties": true, "required": ["arc_id", "name"], "properties": {"arc_id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}}},
    "theme": {"type": "object", "additionalProperties": true, "required": ["theme_id", "name"], "properties": {"theme_id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": true, "required": ["evidence_id", "source_type", "confidence"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "source_type": {"enum": ["metadata", "page", "panel", "text_region", "ocr", "vision", "inference", "user"]}, "document_id": {"type": ["string", "null"]}, "page_id": {"type": ["string", "null"]}, "panel_id": {"type": ["string", "null"]}, "confidence": {"$ref": "#/$defs/score"}}},
    "candidate": {
      "type": "object", "additionalProperties": true,
      "required": ["candidate_id", "document_id", "issue_id", "story_id", "page_id", "rank", "score", "moment_type", "summary", "entities", "events", "themes", "arc_ids", "confidence", "evidence_ids"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "document_id": {"$ref": "#/$defs/id"}, "issue_id": {"$ref": "#/$defs/id"}, "story_id": {"$ref": "#/$defs/id"}, "page_id": {"$ref": "#/$defs/id"}, "panel_id": {"type": ["string", "null"]}, "rank": {"type": "integer", "minimum": 1}, "score": {"$ref": "#/$defs/score"}, "moment_type": {"type": "string"}, "summary": {"type": "string"}, "entities": {"$ref": "#/$defs/idList"}, "events": {"$ref": "#/$defs/idList"}, "themes": {"$ref": "#/$defs/idList"}, "arc_ids": {"$ref": "#/$defs/idList"}, "publication_order": {"type": ["integer", "null"]}, "story_order": {"type": ["integer", "null"]}, "technical_hints": {"type": "object"}, "confidence": {"$ref": "#/$defs/score"}, "evidence_ids": {"$ref": "#/$defs/idList"}}
    }
  }
}
